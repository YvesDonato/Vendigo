# Optional. The preserved ESP32 firmware serves MJPEG on port 81.
# Leave blank to show the camera's offline state. No API keys are required.
CAMERA_STREAM_URL=
# Example: http://192.168.1.123:81/stream

# Optional absolute customer-facing origin for printed robot QR codes.
# Use your computer's LAN address for phones at the venue (not localhost).
NEXT_PUBLIC_SHOP_ORIGIN=
