# Optional. The preserved ESP32 firmware serves MJPEG on port 81.
# Preserved legacy API only; the active shop/dashboard has no camera UI.
CAMERA_STREAM_URL=
# Example: http://192.168.1.123:81/stream

# Optional absolute customer-facing origin for printed robot QR codes.
# Use your computer's LAN address for phones at the venue (not localhost).
NEXT_PUBLIC_SHOP_ORIGIN=

# Preserved voice and agent integration settings
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_SPEECH_ENGINE_ID=
VOICE_SERVER_INTERNAL_URL=http://127.0.0.1:3001
VOICE_SERVER_PORT=3001

# Vendi Python voice subsystem: python3 -m vendi.voice_demo --live
# Matilda: adult American female, warm/upbeat alto; natural pitch, light playful delivery.
# Keep the chosen voice here/in .env.local; no IDs are embedded in TTS code.
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL=eleven_flash_v2_5
OPENAI_MODEL=gpt-5.6-luna
# PortAudio device index or name; blank uses the system default. See --list-devices.
VENDI_AUDIO_OUTPUT=
VENDI_AUDIO_INPUT=
# Optional offline STT: unpacked English Vosk model directory; used only with provider=vosk.
VENDI_VOSK_MODEL_PATH=
# Live conversation uses ElevenLabs Scribe. Select vosk explicitly for offline recognition.
VENDI_STT_PROVIDER=elevenlabs
VENDI_STT_MODEL=scribe_v2_realtime
# Wait this long after speech before answering; brief thinking pauses stay in one turn.
VENDI_END_SILENCE=1.2
# A started utterance gets its own budget, independent of the time spent waiting for speech.
VENDI_MAX_UTTERANCE=45
VENDI_SPEECH_RMS_THRESHOLD=250
CONVERSATION_TIMEOUT=30
# Time to start speaking in standalone STT / purchase tests. Conversations use their inactivity budget.
VENDI_LISTEN_TIMEOUT=8
VENDI_REQUEST_TIMEOUT=15
VENDI_ECHO_GUARD=0.2
VENDI_FUNNY_PROBABILITY=0.12
VENDI_PHRASE_PROBABILITY=0.65
# Optional paths; defaults are repo-relative, not tied to /home/admin.
VENDI_CLIPS_DIR=
VENDI_CACHE_DIR=
VENDI_JINGLE_PATH=

# Authenticated lid API. Paths default to files in robot_code/ on this laptop.
# Use a dedicated public API token; do not give clients the motor-controller token.
LID_API_TOKEN_FILE=robot_code/lid-api.token
LID_CONTROLLER_TOKEN_FILE=robot_code/control.token
LID_CONTROLLER_URL=http://192.168.8.100
# Set to 1 only for a dedicated lid API server; leave unset for the website.
# LID_API_ONLY=1

# Storefront hardware: leave URL empty for simulation. Keep the key server-side.
# On this laptop the existing LID_API_TOKEN_FILE is used when LID_API_KEY is empty.
LID_API_URL=
# Example: https://vendi.yvesdonato.com/api/v1/lid
LID_API_KEY=

# Persistent inventory.json, purchases.json, analytics.json directory.
VENDIGO_DATA_DIR=data
# Optional legacy state.json path to import once; normally leave unset.
# VENDIGO_DATA_FILE=data/state.json
# Live inventory source for Vendi; fetched before each conversational turn.
VENDIGO_APP_URL=http://127.0.0.1:3000
