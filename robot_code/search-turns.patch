+def clearest_direction(observation, now, preferred="left"):
+    """Rank the currently visible sectors, preserving the existing motion veto."""
+    clear = scene_motion_options(observation, now)
+    points = observation.points
+    angles = np.arctan2(points[:, 1], points[:, 0])
+    sectors = {"left": angles > .35, "straight": np.abs(angles) <= .35, "right": angles < -.35}
+    scores = {direction: min(4., float(np.linalg.norm(points[mask], axis=1).min())) if mask.any() else 4.
+              for direction, mask in sectors.items() if direction in clear}
+    if not scores:
+        return "stop"
+    # Prefer forward and a consistent side when estimated clearances are similar.
+    best = max(scores.values())
+    for direction in ("straight", preferred, "left", "right"):
+        if direction in scores and scores[direction] >= .9 * best:
+            return direction
+
 
